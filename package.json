{
  "name": "badmintoner",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 2000",
    "build": "next build --webpack",
    "start": "next start -p 2000",
    "lint": "eslint",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "lint:queuing": "eslint app/queuing tests/queuing",
    "test:payments:unit": "vitest run tests/queuing/billing.test.ts tests/queuing/payment-audit/calculation.test.ts tests/queuing/payment-audit/commands.test.ts tests/queuing/payment-audit/defects.test.ts",
    "test:payments:baseline": "playwright test tests/queuing/payments.spec.ts",
    "test:payments:e2e": "playwright test --config playwright.payments.config.ts",
    "test:payments:defects": "vitest run tests/queuing/payment-audit/defects.test.ts",
    "test:payments": "npm run test:payments:unit && npm run test:payments:e2e",
    "test:payments:defects:e2e": "PAYMENT_AUDIT_DEFECTS=1 PAYMENT_AUDIT_OUTPUT=test-results/payment-audit-defects playwright test --config playwright.payments.config.ts"
  },
  "dependencies": {
    "@ant-design/nextjs-registry": "^1.3.0",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@ducanh2912/next-pwa": "^10.0.5",
    "@tanstack/react-query": "^5.90.19",
    "@types/leaflet": "^1.9.21",
    "antd": "^6.2.1",
    "leaflet": "^1.9.4",
    "next": "16.1.4",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-leaflet": "^5.0.0",
    "uuid": "^13.0.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/uuid": "^10.0.0",
    "eslint": "^9",
    "eslint-config-next": "16.1.4",
    "fake-indexeddb": "^6.2.7",
    "typescript": "^5",
    "vitest": "^3.2.7"
  }
}
